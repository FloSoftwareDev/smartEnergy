{% extends 'base.html.twig' %}

{% block title %}Zonne-energie Dashboard{% endblock %}

{% block stylesheets %}
    {{ parent() }}
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.1.3/dist/css/bootstrap.min.css" rel="stylesheet">
    <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css" rel="stylesheet">
    <style>
        body { background: #fafbfc; }
        .dashboard-header {
            background: #fff;
            border-bottom: 1px solid #eee;
            padding: 1.5rem 0;
        }
        .dashboard-header .logo {
            font-weight: 700;
            font-size: 1.3rem;
            letter-spacing: 0.5px;
        }
        .dashboard-header nav a {
            color: #222;
            margin-left: 2rem;
            font-weight: 500;
            text-decoration: none;
        }
        .dashboard-header nav a:hover {
            text-decoration: underline;
        }
        .main-title {
            font-size: 2.2rem;
            font-weight: 700;
            margin-bottom: 0.5rem;
        }
        .main-subtitle {
            color: #888;
            margin-bottom: 1.5rem;
        }
        .main-actions .btn {
            margin-right: 1rem;
            min-width: 160px;
        }
        .section-title {
            font-size: 1.4rem;
            font-weight: 600;
            margin: 2.5rem 0 1.2rem 0;
            text-align: center;
        }
        .status-cards {
            display: flex;
            gap: 2rem;
            justify-content: center;
            margin-bottom: 2rem;
        }
        .status-card {
            background: #fff;
            border-radius: 12px;
            box-shadow: 0 2px 8px rgba(0,0,0,0.04);
            padding: 1.5rem 2rem;
            min-width: 180px;
            text-align: center;
        }
        .status-card .value {
            font-size: 2rem;
            font-weight: 700;
            color: #222;
        }
        .status-card .label {
            color: #888;
            font-size: 1rem;
        }
        .status-card .label.small {
            font-size: 0.8rem;
            color: #888;
        }
        .chart-section {
            background: #fff;
            border-radius: 18px;
            box-shadow: 0 4px 24px rgba(0,0,0,0.07), 0 1.5px 4px rgba(0,0,0,0.04);
            padding: 2.5rem 2rem 2rem 2rem;
            margin-bottom: 2rem;
            max-width: 700px;
            margin-left: auto;
            margin-right: auto;
            overflow-x: auto;
            transition: box-shadow 0.2s;
        }
        #energyBarChart, #statusLineChart {
            width: 1200px !important;
            height: 120px !important;
            min-width: 700px !important;
            max-width: none !important;
            max-height: 200px !important;
            display: block;
            border-radius: 14px;
            box-shadow: 0 2px 12px rgba(78,115,223,0.08);
            background: #f8fafc;
        }
        .env-cards {
            display: flex;
            gap: 1.5rem;
            justify-content: center;
            flex-wrap: wrap;
        }
        .env-card {
            background: #f5f6fa;
            border-radius: 10px;
            padding: 1.2rem 1.5rem;
            min-width: 180px;
            text-align: center;
            margin-bottom: 1rem;
        }
        .hydrogen-cards {
            display: flex;
            gap: 2rem;
            justify-content: center;
            margin: 2rem 0;
        }
        .hydrogen-card {
            background: #fff;
            border-radius: 12px;
            box-shadow: 0 2px 8px rgba(0,0,0,0.04);
            padding: 1.5rem 1.2rem;
            min-width: 140px;
            text-align: center;
        }
        .hydrogen-card i {
            font-size: 2rem;
            margin-bottom: 0.5rem;
        }
        .footer {
            background: #fff;
            border-top: 1px solid #eee;
            padding: 1rem 0;
            text-align: center;
            color: #888;
            font-size: 0.95rem;
            margin-top: 2rem;
        }
        .status-card .chart-scroll-x {
            overflow-x: auto;
            width: 100%;
        }
    </style>
{% endblock %}

{% block body %}
{% set current = (excelData|reverse|filter(r => r.timestamp is not empty)|first) %}
<div class="dashboard-header d-flex align-items-center justify-content-between px-4">
    <div class="logo">Zonne-energie Dashboard</div>
    <nav>
        <a href="#">Home</a>
        <a href="#">Data</a>
        <a href="#">Instellingen</a>
    </nav>
</div>

<div class="container py-4">
    <div class="text-center mb-4">
        <div class="main-title">Realtime Energie Overzicht</div>
        <div class="main-subtitle">Overzicht van zonne-energieproductie en verbruik</div>
        <div class="main-actions mb-3">
            <button class="btn btn-dark">Verken Meer</button>
            <button class="btn btn-outline-dark">Download Rapport</button>
        </div>
    </div>

    <div class="section-title">Huidige Status</div>
    {% set last24 = excelData|slice(-24, 24) %}
    {% set avg_solar = last24|map(r => (r.solar_panel_current is defined ? r.solar_panel_current|replace({',':'.'})|default('0')|trim * 1 : 0))|reduce((a, b) => a + b, 0) / (last24|length > 0 ? last24|length : 1) %}
    {% set avg_consumption = last24|map(r => (r.house_power_consumption is defined ? r.house_power_consumption|replace({',':'.'})|default('0')|trim * 1 : 0))|reduce((a, b) => a + b, 0) / (last24|length > 0 ? last24|length : 1) %}
    <div class="status-cards">
        <div class="status-card">
            <div class="value">{{ current.solar_panel_current is defined ? current.solar_panel_current|replace({',':'.'})|number_format(2, '.', '') : 'n/a' }}</div>
            <div class="label">Zonne-opwekking (kW)</div>
            <div class="label small">Gemiddeld 24u: {{ avg_solar|number_format(2, '.', '') }}</div>
        </div>
        <div class="status-card">
            <div class="value">{{ current.hydrogen_production is defined ? current.hydrogen_production|replace({',':'.'})|number_format(2, '.', '') : 'n/a' }}</div>
            <div class="label">Waterstofproductie (kg)</div>
        </div>
        <div class="status-card">
            <div class="value">{{ current.house_power_consumption is defined ? current.house_power_consumption|replace({',':'.'})|number_format(2, '.', '') : 'n/a' }}</div>
            <div class="label">Stroomverbruik (kW)</div>
            <div class="label small">Gemiddeld 24u: {{ avg_consumption|number_format(2, '.', '') }}</div>
        </div>
        <div class="status-card flex-grow-1" style="min-width:320px;">
            <div class="chart-scroll-x">
                <canvas id="statusLineChart" height="60"></canvas>
            </div>
            <div class="label mt-2">Waterstofproductie Door de Tijd</div>
        </div>
    </div>

    <div class="section-title">Energieverbruik en Productie Tijdlijn</div>
    <div class="chart-section">
        <canvas id="energyBarChart" height="120"></canvas>
        <div class="label mt-2 text-center">Stroomverbruik vs Zonnepaneelstroom</div>
    </div>

    <div class="section-title">Omgevingscondities</div>
    <div class="env-cards mb-4">
        <div class="env-card">
            <div class="label">Luchtdruk</div>
            <div class="value">{{ current.air_pressure is defined ? current.air_pressure|replace({',':'.'})|number_format(2, '.', '') : 'n/a' }} hPa</div>
        </div>
        <div class="env-card">
            <div class="label">Luchtvochtigheid</div>
            <div class="value">{{ current.humidity is defined ? current.humidity|replace({',':'.'})|number_format(2, '.', '') : 'n/a' }}%</div>
        </div>
        <div class="env-card">
            <div class="label">Accuniveau</div>
            <div class="value">{{ current.battery_level is defined ? current.battery_level|replace({',':'.'})|number_format(2, '.', '') : 'n/a' }}%</div>
        </div>
        <div class="env-card">
            <div class="label">CO₂-concentratie Binnen</div>
            <div class="value">{{ current.co2_concentration_inside is defined ? current.co2_concentration_inside|replace({',':'.'})|number_format(2, '.', '') : 'n/a' }} ppm</div>
        </div>
    </div>

    <div class="section-title">Waterstofverbruik & Opslag</div>
    <div class="hydrogen-cards">
        <div class="hydrogen-card">
            <i class="fas fa-car text-danger"></i>
            <div class="label">Waterstofverbruik Auto</div>
            <div class="value">{{ current.car_hydrogen_consumption is defined ? current.car_hydrogen_consumption|replace({',':'.'})|number_format(2, '.', '') : 'n/a' }} L/u</div>
        </div>
        <div class="hydrogen-card">
            <i class="fas fa-tools text-secondary"></i>
            <div class="label">Waterstofopslag Woning</div>
            <div class="value">{{ current.house_hydrogen_storage is defined ? current.house_hydrogen_storage|replace({',':'.'})|number_format(2, '.', '') : 'n/a' }}%</div>
        </div>
        <div class="hydrogen-card">
            <i class="fas fa-battery-full text-success"></i>
            <div class="label">Accuniveau</div>
            <div class="value">{{ current.battery_level is defined ? current.battery_level|replace({',':'.'})|number_format(2, '.', '') : 'n/a' }}%</div>
        </div>
        <div class="hydrogen-card">
            <i class="fas fa-globe text-info"></i>
            <div class="label">CO₂-concentratie Binnen</div>
            <div class="value">{{ current.co2_concentration_inside is defined ? current.co2_concentration_inside|replace({',':'.'})|number_format(2, '.', '') : 'n/a' }} ppm</div>
        </div>
    </div>

</div>

<div class="footer">
    <span>Privacybeleid</span> &nbsp;|&nbsp;
    <span>Algemene Voorwaarden</span> &nbsp;|&nbsp;
    <span>Contact</span>
</div>
{% endblock %}

{% block javascripts %}
    {{ parent() }}
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.1.3/dist/js/bootstrap.bundle.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.1/dist/chart.umd.min.js"></script>
    <script>
        console.log('Chart after load:', typeof Chart);
    </script>
    <script>
        // Passes the excelData from Twig/PHP to JavaScript as a global variable
        window.excelData = {{ excelData|json_encode|raw }};

        // Wait for the DOM to be fully loaded before running chart initialization
        document.addEventListener('DOMContentLoaded', function() {
            // Prevents re-initialization if already done (e.g., on hot reload)
            if (window.energyBarChartInitialized) return;
            window.energyBarChartInitialized = true;

            // --- ENERGY BAR CHART ---
            // Select the chart container for the energy bar chart
            const container = document.querySelector('.chart-section');
            if (container) {
                // Remove any existing canvas with the same ID to avoid duplicates
                document.querySelectorAll('#energyBarChart').forEach(c => c.remove());
                // Create a new canvas element for the bar chart
                const newCanvas = document.createElement('canvas');
                newCanvas.id = 'energyBarChart';
                newCanvas.height = 120;
                newCanvas.width = 1200;
                newCanvas.style.width = '100%';
                newCanvas.style.maxWidth = '700px';
                newCanvas.style.height = '120px';
                newCanvas.style.borderRadius = '14px';
                newCanvas.style.boxShadow = '0 2px 12px rgba(78,115,223,0.08)';
                newCanvas.style.background = '#f8fafc';
                // Insert the new canvas at the top of the container
                container.prepend(newCanvas);

                // Get the 2D drawing context for Chart.js
                const ctx = newCanvas.getContext('2d');
                // Create vertical gradients for each dataset (bar color)
                const stroomverbruikGradient = ctx.createLinearGradient(0, 0, 0, 120);
                stroomverbruikGradient.addColorStop(0, '#6fd37c');
                stroomverbruikGradient.addColorStop(1, '#b2f7c1');
                const zonnepaneelGradient = ctx.createLinearGradient(0, 0, 0, 120);
                zonnepaneelGradient.addColorStop(0, '#4e73df');
                zonnepaneelGradient.addColorStop(1, '#a3bffa');

                // Prepare the last 24 records with a timestamp for the chart
                const data = window.excelData.filter(r => r.timestamp).slice(-24);
                // Extract time labels (HH:MM:SS) from the timestamp
                const labels = data.map(r => (r.timestamp.split(' ')[1] || r.timestamp));
                // Extract house power consumption and solar panel current as float arrays
                const stroomverbruik = data.map(r => parseFloat((r.house_power_consumption || '0').replace(',', '.')));
                const zonnepaneel = data.map(r => parseFloat((r.solar_panel_current || '0').replace(',', '.')));

                // Initialize the Chart.js bar chart instance
                window.energyBarChartInstance = new Chart(ctx, {
                    type: 'bar',
                    data: {
                        labels: labels,
                        datasets: [
                            {
                                label: 'Stroomverbruik (kW)', // House power consumption
                                data: stroomverbruik,
                                backgroundColor: stroomverbruikGradient,
                                borderRadius: 10,
                                borderSkipped: false,
                                hoverBackgroundColor: '#4e73df',
                                barPercentage: 0.7,
                                categoryPercentage: 0.6
                            },
                            {
                                label: 'Zonnepaneelstroom (A)', // Solar panel current
                                data: zonnepaneel,
                                backgroundColor: zonnepaneelGradient,
                                borderRadius: 10,
                                borderSkipped: false,
                                hoverBackgroundColor: '#6fd37c',
                                barPercentage: 0.7,
                                categoryPercentage: 0.6
                            }
                        ]
                    },
                    options: {
                        plugins: {
                            legend: {
                                display: true,
                                labels: {
                                    color: '#222',
                                    font: { size: 14, weight: 'bold' }
                                }
                            },
                            tooltip: {
                                enabled: true,
                                backgroundColor: '#fff',
                                titleColor: '#4e73df',
                                bodyColor: '#222',
                                borderColor: '#4e73df',
                                borderWidth: 1,
                                padding: 12,
                                cornerRadius: 8
                            }
                        },
                        scales: {
                            x: {
                                grid: {
                                    display: false // Hide vertical grid lines
                                },
                                ticks: {
                                    color: '#888',
                                    font: { size: 12 }
                                }
                            },
                            y: {
                                beginAtZero: true,
                                grid: {
                                    color: 'rgba(78,115,223,0.08)', // Subtle horizontal grid lines
                                    borderDash: [4, 4]
                                },
                                ticks: {
                                    color: '#888',
                                    font: { size: 12 }
                                }
                            }
                        },
                        responsive: false,
                        maintainAspectRatio: false
                    }
                });
            }

            // --- STATUS LINE CHART (Hydrogen Production Over Time) ---
            // Get the canvas for the status line chart
            const statusLineChartContainer = document.getElementById('statusLineChart');
            if (statusLineChartContainer) {
                // Set explicit width and height for consistent rendering
                statusLineChartContainer.width = 1200;
                statusLineChartContainer.height = 80;
                // Get the 2D context for Chart.js
                const ctx2 = statusLineChartContainer.getContext('2d');
                // Create a vertical gradient for the line fill
                const lineGradient = ctx2.createLinearGradient(0, 0, 0, 80);
                lineGradient.addColorStop(0, 'rgba(78,115,223,0.25)');
                lineGradient.addColorStop(1, 'rgba(78,115,223,0.02)');
                // Prepare the last 24 records for the line chart
                const data = window.excelData.filter(r => r.timestamp).slice(-24);
                // Extract time labels (HH:MM:SS) from the timestamp
                const labels = data.map(r => r.timestamp ? r.timestamp.split(' ')[1] : '');
                // Extract hydrogen production values as floats
                const waterstof = data.map(r => parseFloat((r.hydrogen_production || '0').replace(',', '.')));
                // Destroy any previous chart instance to avoid memory leaks
                if (window.statusLineChartInstance) {
                    window.statusLineChartInstance.destroy();
                }
                // Initialize the Chart.js line chart instance
                window.statusLineChartInstance = new Chart(ctx2, {
                    type: 'line',
                    data: {
                        labels: labels,
                        datasets: [{
                            label: 'Waterstofproductie', // Hydrogen production
                            data: waterstof,
                            borderColor: '#4e73df',
                            backgroundColor: lineGradient,
                            fill: true,
                            tension: 0.45, // Smooth the line
                            pointBackgroundColor: '#fff',
                            pointBorderColor: '#4e73df',
                            pointRadius: 4,
                            pointHoverRadius: 7,
                            pointBorderWidth: 2
                        }]
                    },
                    options: {
                        plugins: {
                            legend: { display: false },
                            tooltip: {
                                enabled: true,
                                backgroundColor: '#fff',
                                titleColor: '#4e73df',
                                bodyColor: '#222',
                                borderColor: '#4e73df',
                                borderWidth: 1,
                                padding: 12,
                                cornerRadius: 8
                            }
                        },
                        scales: {
                            x: {
                                display: false // Hide x-axis for a cleaner look
                            },
                            y: {
                                beginAtZero: true,
                                grid: {
                                    color: 'rgba(78,115,223,0.08)', // Subtle horizontal grid lines
                                    borderDash: [4, 4]
                                },
                                ticks: {
                                    color: '#888',
                                    font: { size: 12 }
                                }
                            }
                        },
                        responsive: false,
                        maintainAspectRatio: false
                    }
                });
            }
        });
    </script>
{% endblock %} 